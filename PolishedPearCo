<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Polished Pear & Company | Elevated Spaces, Thoughtfully Done</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F5F2ED;
    --parchment: #EDE8DF;
    --sage: #7A8C6E;
    --sage-dark: #4A5C40;
    --sage-light: #A8B89A;
    --taupe: #B8AC9E;
    --blush: #D9C4BC;
    --mauve: #C4A9A0;
    --charcoal: #2C2C2A;
    --warm-white: #FAF8F5;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--cream);
    color: var(--charcoal);
    font-weight: 300;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 4rem;
    background: rgba(245, 242, 237, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(122, 140, 110, 0.15);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .nav-logo img {
    height: 48px;
    width: auto;
  }

  .nav-wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .nav-wordmark span:first-child {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--sage-dark);
    text-transform: uppercase;
  }

  .nav-wordmark span:last-child {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--taupe);
    text-transform: uppercase;
    margin-top: 2px;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sage-dark);
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--sage); }

  .nav-cta {
    background: var(--sage-dark);
    color: var(--warm-white) !important;
    padding: 0.6rem 1.4rem;
    border-radius: 2px;
  }

  .nav-cta:hover { background: var(--sage); color: var(--warm-white) !important; }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 80px;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 4rem 5rem 6rem;
  }

  .hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--sage-light);
  }

  .hero-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 4.5vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--sage-dark);
    margin-bottom: 1.5rem;
  }

  .hero-headline em {
    font-style: italic;
    color: var(--sage);
  }

  .hero-sub {
    font-size: 1rem;
    line-height: 1.8;
    color: #6B6560;
    max-width: 420px;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .btn-primary {
    background: var(--sage-dark);
    color: var(--warm-white);
    text-decoration: none;
    padding: 0.9rem 2rem;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--sage); }

  .btn-outline {
    border: 1px solid var(--sage-dark);
    color: var(--sage-dark);
    text-decoration: none;
    padding: 0.9rem 2rem;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .btn-outline:hover { background: var(--sage-dark); color: var(--warm-white); }

  .hero-right {
    position: relative;
    overflow: hidden;
  }

  .hero-right img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(to top, rgba(74,92,64,0.85) 0%, transparent 50%);
    padding: 2.5rem 2rem 1.5rem;
  }

  .hero-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.9);
    text-transform: uppercase;
    text-align: center;
  }

  /* MARQUEE STRIP */
  .marquee-strip {
    background: var(--sage-dark);
    padding: 0.9rem 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-inner {
    display: inline-flex;
    gap: 3rem;
    animation: marquee 25s linear infinite;
  }

  .marquee-inner span {
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sage-light);
  }

  .marquee-dot { color: var(--blush); }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* INTRO */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 70vh;
  }

  .intro-image {
    background: var(--parchment);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 4rem;
  }

  .intro-logo-large {
    width: 260px;
    opacity: 0.85;
  }

  .intro-content {
    padding: 5rem 5rem 5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--warm-white);
  }

  .section-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 1.2rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    color: var(--sage-dark);
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .section-title em {
    font-style: italic;
  }

  .section-body {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #6B6560;
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .divider-leaf {
    width: 60px;
    height: 1px;
    background: var(--sage-light);
    margin: 2rem 0;
    position: relative;
  }

  .divider-leaf::after {
    content: '❧';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--warm-white);
    color: var(--sage-light);
    font-size: 1rem;
    padding: 0 0.4rem;
    width: 60px;
    text-align: center;
  }

  /* SERVICES */
  .services {
    padding: 7rem 6rem;
    background: var(--cream);
  }

  .services-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--taupe);
  }

  .service-card {
    background: var(--warm-white);
    padding: 3rem 2.5rem;
    position: relative;
    transition: background 0.3s;
  }

  .service-card:hover {
    background: var(--parchment);
  }

  .service-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 300;
    color: var(--sage-light);
    line-height: 1;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .service-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 1.2rem;
    color: var(--sage);
  }

  .service-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--sage-dark);
    margin-bottom: 0.8rem;
    letter-spacing: 0.02em;
  }

  .service-desc {
    font-size: 0.88rem;
    line-height: 1.75;
    color: #7A7571;
    font-weight: 300;
  }

  .service-tag {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
    border-bottom: 1px solid var(--sage-light);
    padding-bottom: 2px;
  }

  /* PROCESS */
  .process {
    background: var(--sage-dark);
    padding: 7rem 6rem;
    color: var(--cream);
  }

  .process-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .process-header .section-eyebrow { color: var(--sage-light); }

  .process-header .section-title { color: var(--cream); }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    position: relative;
  }

  .process-steps::before {
    content: '';
    position: absolute;
    top: 2.5rem;
    left: calc(12.5% + 1.5rem);
    right: calc(12.5% + 1.5rem);
    height: 1px;
    background: rgba(168, 184, 154, 0.3);
  }

  .process-step {
    text-align: center;
    position: relative;
  }

  .step-circle {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    border: 1px solid var(--sage-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--sage-light);
    background: var(--sage-dark);
    position: relative;
    z-index: 1;
  }

  .step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 0.6rem;
    letter-spacing: 0.05em;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--sage-light);
    font-weight: 300;
  }

  /* TESTIMONIALS */
  .testimonials {
    padding: 7rem 6rem;
    background: var(--parchment);
  }

  .testimonials-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .testimonial-card {
    background: var(--warm-white);
    padding: 2.5rem;
    border-radius: 2px;
    border-left: 3px solid var(--sage-light);
  }

  .testimonial-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--charcoal);
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .testimonial-author {
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .testimonial-location {
    font-size: 0.75rem;
    color: var(--taupe);
    margin-top: 0.2rem;
  }

  /* ABOUT */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 60vh;
  }

  .about-content {
    padding: 6rem 4rem 6rem 6rem;
    background: var(--warm-white);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-team {
    background: var(--parchment);
    position: relative;
    overflow: hidden;
  }

  .about-team img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* CTA */
  .cta-section {
    background: var(--blush);
    padding: 6rem;
    text-align: center;
  }

  .cta-section .section-title { color: var(--sage-dark); }
  .cta-section .section-body { max-width: 560px; margin: 0 auto 2.5rem; }

  /* FOOTER */
  footer {
    background: var(--charcoal);
    color: var(--taupe);
    padding: 4rem 6rem 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 2rem;
  }

  .footer-brand img {
    height: 60px;
    margin-bottom: 1rem;
    filter: brightness(0.8) sepia(0.3) saturate(0.5);
  }

  .footer-brand p {
    font-size: 0.82rem;
    line-height: 1.7;
    color: #8A8580;
  }

  .footer-col h4 {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage-light);
    margin-bottom: 1.2rem;
    font-weight: 400;
  }

  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 0.6rem; }
  .footer-col a {
    text-decoration: none;
    font-size: 0.85rem;
    color: #8A8580;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--sage-light); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #5A5550;
  }

  /* MOBILE */
  @media (max-width: 900px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-left { padding: 4rem 2rem 3rem; }
    .hero-right { height: 60vw; }
    .intro, .about { grid-template-columns: 1fr; }
    .intro-image { display: none; }
    .intro-content { padding: 4rem 2rem; }
    .services { padding: 4rem 1.5rem; }
    .services-grid { grid-template-columns: 1fr; gap: 2px; }
    .process { padding: 4rem 1.5rem; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .process-steps::before { display: none; }
    .testimonials { padding: 4rem 1.5rem; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .about-content { padding: 4rem 2rem; }
    .about-team { height: 60vw; }
    .cta-section { padding: 4rem 2rem; }
    footer { padding: 3rem 2rem 2rem; }
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
    .footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">
    <img src="data:image/png;base64," alt="Polished Pear & Company">
    <div class="nav-wordmark">
      <span>Polished Pear</span>
      <span>& Company</span>
    </div>
  </a>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
