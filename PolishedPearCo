    <li><a href="#contact" class="nav-cta">Book a Consult</a></li>
  </ul>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">Dallas, TX &amp; Surrounding Areas</p>
    <h1 class="hero-headline">Your space,<br><em>beautifully</em><br>reimagined.</h1>
    <p class="hero-sub">We transform cluttered homes and businesses into calm, functional environments — with personalized systems built to last.</p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Book a Free Consult</a>
      <a href="#services" class="btn-outline">Our Services</a>
